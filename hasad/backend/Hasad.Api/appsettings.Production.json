{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sql-server;Database=HasadDb;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Key": "Production_Super_Secret_Key_At_Least_32_Chars_Long!",
    "Issuer": "https://hasad-api.gov.ps",
    "Audience": "hasad-clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "PushNotifications": {
    "Fcm": {
      "ProjectId": "hasad-prod",
      "ServiceAccountJson": "/app/secrets/fcm-service-account.json"
    },
    "Apns": {
      "BundleId": "ps.gov.hasad",
      "TeamId": "YOUR_TEAM_ID",
      "KeyId": "YOUR_KEY_ID",
      "PrivateKey": "/app/secrets/apns-private-key.p8",
      "UseSandbox": false
    }
  },
  "AdminPortalUrl": "http://localhost:5080",
  "AllowedHosts": "*"
}
